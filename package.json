{
  "name": "grounded",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Grounded — a production-grade RAG starter: cited answers, idempotent ingestion, retries, an \"I don't know\" guardrail, and an eval harness. Provider- and store-agnostic, fully testable offline.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "ingest": "tsx src/cli/ingest.ts",
    "ask": "tsx src/cli/ask.ts",
    "eval": "tsx src/cli/eval.ts",
    "migrate": "tsx src/stores/pgvector-migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "openai": "^4.77.0",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
