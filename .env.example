# ── Provider ────────────────────────────────────────────────────────────────
# offline = HashEmbedder + extractive answers (no key, for demos/tests)
# openai  = real embeddings + generated answers
PROVIDER=offline

# ── Store ───────────────────────────────────────────────────────────────────
# memory   = in-process (server demo / tests)
# pgvector = persistent (run `npm run migrate` first)
STORE=memory

# ── OpenAI (when PROVIDER=openai) ─────────────────────────────────────────────
OPENAI_API_KEY=
# Optional: Azure / proxy / OpenAI-compatible endpoint
# OPENAI_BASE_URL=
EMBED_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
# Must match your embedding model's dimensions (and the migrated table).
EMBED_DIM=1536

# ── pgvector (when STORE=pgvector) ───────────────────────────────────────────
DATABASE_URL=postgresql://localhost:5432/grounded

# ── Retrieval ────────────────────────────────────────────────────────────────
RAG_K=5
RAG_MIN_SCORE=0.25
PORT=3000
